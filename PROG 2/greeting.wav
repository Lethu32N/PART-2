using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace CybersecurityWPF
{
    class greeting
    {
    }
}
using System;
using System.IO;
using System.Media;
using System.Threading.Tasks;

namespace CybersecurityBotGUI.Audio
{
    public class VoiceGreeting
    {
        public string GreetingText
        {
            get
            {
                return "Welcome to CyberBot. Your cybersecurity awareness assistant.";
            }
        }

        public async void PlayAsync()
        {
            await Task.Run(() =>
            {
                try
                {
                    string path = Path.Combine(
                        AppDomain.CurrentDomain.BaseDirectory,
                        "Assets",
                        "greeting.wav");

                    if (File.Exists(path))
                    {
                        using (SoundPlayer player = new SoundPlayer(path))
                        {
                            player.PlaySync();
                        }
                    }
                }
                catch
                {
                    // Ignore audio errors
                }
            });
        }
    }
}